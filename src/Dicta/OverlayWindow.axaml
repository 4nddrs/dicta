<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dicta.Controls"
        x:Class="Dicta.OverlayWindow"
        Title="Dicta"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6E62F6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7D72FF" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="#E4E4EE" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#24FFFFFF" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="#2AFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.key > TextBlock">
      <Setter Property="Foreground" Value="#E0E0EA" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </Window.Styles>

  <Border Margin="10" CornerRadius="18" BoxShadow="0 12 32 0 #55000000">
    <Border CornerRadius="18" BorderBrush="#2EFFFFFF" BorderThickness="1" ClipToBounds="True">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,120%">
          <GradientStop Color="#F5161720" Offset="0" />
          <GradientStop Color="#F20C0D14" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel Margin="14,10" Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse x:Name="StatusDot" Grid.Column="0" Width="9" Height="9" Fill="#6E62F6" VerticalAlignment="Center" Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="TitleText" Text="Dicta" FontSize="14" FontWeight="SemiBold" Foreground="#F7F7FB" />
            <TextBlock x:Name="SubtitleText" Text="English at the cursor" FontSize="12" Foreground="#9B9BAE" />
          </StackPanel>
          <Border Grid.Column="2" Background="#186E62F6" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
            <TextBlock x:Name="BadgeText" Text="EN" FontSize="11" FontWeight="SemiBold" Foreground="#D9D4FF" />
          </Border>
        </Grid>

        <controls:WaveformView x:Name="Wave" Height="22" IsVisible="False" />

        <SelectableTextBlock x:Name="BodyText"
                             TextWrapping="Wrap"
                             FontSize="14"
                             LineHeight="20"
                             Foreground="#ECECF4"
                             MaxHeight="96"
                             TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="HintText"
                   TextWrapping="Wrap"
                   FontSize="12"
                   LineHeight="17"
                   Foreground="#8E8EA2" />

        <StackPanel x:Name="SetupList" IsVisible="False" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="Microphone" FontSize="13" FontWeight="SemiBold" Foreground="#F7F7FB" />
              <TextBlock x:Name="MicState" Text="Needed" FontSize="12" Foreground="#FF8A96" />
            </StackPanel>
            <Button x:Name="MicButton" Classes="ghost" Grid.Column="1" Content="Allow" MinWidth="76" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="Accessibility" FontSize="13" FontWeight="SemiBold" Foreground="#F7F7FB" />
              <TextBlock x:Name="AccessState" Text="Needed" FontSize="12" Foreground="#FF8A96" />
            </StackPanel>
            <Button x:Name="AccessButton" Classes="ghost" Grid.Column="1" Content="Allow" MinWidth="76" />
          </Grid>
        </StackPanel>

        <StackPanel x:Name="Keys" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
          <Border Classes="key"><TextBlock Text="Ctrl" /></Border>
          <Border Classes="key"><TextBlock Text="Shift" /></Border>
          <Border Classes="key"><TextBlock Text="Space" /></Border>
        </StackPanel>

        <ProgressBar x:Name="Progress"
                     Minimum="0"
                     Maximum="100"
                     Height="4"
                     IsVisible="False"
                     Foreground="#8B7CFF"
                     Background="#18FFFFFF" />

        <Grid x:Name="ButtonRow" ColumnDefinitions="*,Auto">
          <Button x:Name="PrimaryButton" Classes="primary" Content="Got it" />
          <Button x:Name="SecondaryButton" Classes="ghost" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" IsVisible="False" />
        </Grid>
      </StackPanel>
    </Border>
  </Border>
</Window>
